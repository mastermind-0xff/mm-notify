{
  "name": "@mmutils/notify",
  "version": "0.1.0",
  "description": "Small on-page notifications: four kinds, a live region, a flash across redirects. Loaded on first use, with its CSS in the module and no dependencies.",
  "keywords": [
    "notification",
    "toast",
    "flash",
    "popover",
    "aria-live",
    "snackbar",
    "progress",
    "accessibility",
    "browser",
    "typescript",
    "mmutils"
  ],
  "author": "Tihomir Trifonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastermind-0xff/mm-notify.git"
  },
  "homepage": "https://github.com/mastermind-0xff/mm-notify#readme",
  "bugs": {
    "url": "https://github.com/mastermind-0xff/mm-notify/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./has-flash": {
      "import": {
        "types": "./dist/types/has-flash.d.ts",
        "default": "./dist/esm/has-flash.js"
      },
      "require": {
        "types": "./dist/types/has-flash.d.cts",
        "default": "./dist/cjs/has-flash.cjs"
      }
    },
    "./css": {
      "import": {
        "types": "./dist/types/css.d.ts",
        "default": "./dist/esm/css.js"
      },
      "require": {
        "types": "./dist/types/css.d.cts",
        "default": "./dist/cjs/css.cjs"
      }
    },
    "./notify.css": "./dist/notify.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "has-flash": [
        "./dist/types/has-flash.d.ts"
      ],
      "css": [
        "./dist/types/css.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/notify.css','dist/notify.css')\" && node scripts/build-cjs-types.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "size": "npm run build && node scripts/size.js",
    "examples": "npm run build && node examples/server.js",
    "test:browsers": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
