{
  "name": "@mmutils/notify",
  "version": "0.0.0",
  "description": "Small on-page notifications: four kinds, a live region, a flash across redirects. Loaded on first use, with its CSS in the module and no dependencies.",
  "keywords": [
    "notification",
    "toast",
    "flash",
    "popover",
    "aria-live",
    "browser",
    "typescript",
    "mmutils"
  ],
  "author": "Tihomir Trifonov",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./has-flash": {
      "types": "./dist/types/has-flash.d.ts",
      "import": "./dist/esm/has-flash.js",
      "require": "./dist/cjs/has-flash.cjs"
    },
    "./notify.css": "./dist/notify.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/notify.css','dist/notify.css')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "size": "npm run build && node scripts/size.js",
    "examples": "npm run build && node examples/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
